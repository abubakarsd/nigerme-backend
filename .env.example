# ── Server & Runtime Environment ──────────────────────
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5173

# ── MongoDB Database Connection ───────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/nigerme_enterprise
MONGODB_MAX_POOL_SIZE=50

# ── Cryptography & JWT Security ────────────────────────
JWT_ACCESS_SECRET=your_jwt_access_secret_32_chars_minimum
JWT_REFRESH_SECRET=your_jwt_refresh_secret_32_chars_minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
DATA_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_for_pii

# ── Media Storage Configuration (AWS S3) ───────────────
STORAGE_PROVIDER=s3
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name
AWS_S3_ACCESS_POINT=your_access_point
AWS_S3_ACCESS_POINT_ARN=your_access_point_arn
AWS_ACCOUNT_ID=your_aws_account_id
AWS_VPC_ID=your_vpc_id
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BASE_FOLDER=nigerme-media
AWS_S3_CUSTOM_DOMAIN=

# ── Provn Identity Verification ────────────────────────
PROVN_API_KEY=your_provn_api_key
PROVN_ACCESS_KEY=your_provn_access_key
PROVN_URL=https://api.provn.ng

# ── Termii OTP SMS Service ─────────────────────────────
TERMII_BASE_URL=https://api.ng.termii.com/api
TERMII_API_LIVE=your_termii_api_live_key
TERMII_SECRET_KEY=your_termii_secret_key
TERMII_SENDER_ID=NIGERME

# ── Paystack Payment Gateway ───────────────────────────
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret
PAYSTACK_BASE_URL=https://api.paystack.co
